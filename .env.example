# Public Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this value in client code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only required by scratch/run-migration.mjs (Supabase personal access token).
SUPABASE_ACCESS_TOKEN=your-management-access-token

# Optional custom Next.js build directory.
NEXT_DIST_DIR=.next
